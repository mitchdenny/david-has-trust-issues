{
  "$schema": "http://json.schemastore.org/template",
  "author": "Mitch Denny",
  "classifications": ["Aspire", "TypeScript", "React", "Express"],
  "identity": "MitchDenny.Aspire.TypeScript.React",
  "name": "Aspire TypeScript AppHost with React and Express",
  "shortName": "david-has-trust-issues",
  "sourceName": "TemplateApp",
  "preferNameDirectory": true,
  "tags": {
    "language": "TypeScript",
    "type": "project"
  },
  "symbols": {
    "AspireVersion": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "17.0.0-preview.1.26520.10",
      "description": "Aspire SDK and hosting integration version; supplied by the custom Aspire CLI.",
      "replaces": "17.0.0-preview.1.26520.10"
    },
    "AspireNuGetSource": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "https://pkgs.dev.azure.com/dnceng/public/_packaging/aspire-dev/nuget/v3/index.json",
      "description": "Raw Aspire NuGet feed URL or local directory; supplied by the custom Aspire CLI."
    },
    "AspireNuGetSourceXml": {
      "type": "derived",
      "valueSource": "AspireNuGetSource",
      "valueTransform": "xmlAttribute",
      "replaces": "https://pkgs.dev.azure.com/dnceng/public/_packaging/aspire-dev/nuget/v3/index.json"
    },
    "NpmName": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "npmName",
      "replaces": "__npm_name__"
    }
  },
  "forms": {
    "npmCharacters": {
      "identifier": "replace",
      "pattern": "[^a-z0-9._-]+",
      "replacement": "-"
    },
    "npmStart": {
      "identifier": "replace",
      "pattern": "^[._-]+",
      "replacement": ""
    },
    "npmName": {
      "identifier": "chain",
      "steps": ["lowerCase", "npmCharacters", "npmStart"]
    },
    "encodeQuotes": {
      "identifier": "replace",
      "pattern": "\"",
      "replacement": "&quot;"
    },
    "xmlAttribute": {
      "identifier": "chain",
      "steps": ["xmlEncode", "encodeQuotes"]
    }
  },
  "sources": [
    {
      "modifiers": [
        {
          "exclude": [
            ".template.config/**",
            "**/.git/**",
            "**/.git",
            ".git",
            ".github/**",
            ".vscode/**",
            "README.md",
            "tests/**",
            ".validation/**",
            "**/.aspire/**",
            "**/.modules/**",
            "**/node_modules/**",
            "**/bin/**",
            "**/obj/**",
            "**/dist/**",
            "**/*.tsbuildinfo",
            "**/.azure/**",
            "**/.env",
            "**/.env.*",
            "**/secrets.json",
            "**/*.user",
            "**/*.suo",
            "**/.DS_Store"
          ]
        }
      ]
    }
  ]
}

<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="aspire-template" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/aspire-dev/nuget/v3/index.json" />
    <add key="nuget-template" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="aspire-template">
      <package pattern="Aspire.*" />
    </packageSource>
    <packageSource key="nuget-template">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
